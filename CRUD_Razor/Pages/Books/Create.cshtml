@page
@model CRUD_Razor.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Add New Book";
}

<div class="container mt-4">
    <h2>Add New Book</h2>
    <hr />

    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Book.title" class="form-label">Title</label>
            <input asp-for="Book.title" class="form-control" />
            <span asp-validation-for="Book.title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Book.author" class="form-label">Author</label>
            <input asp-for="Book.author" class="form-control" />
            <span asp-validation-for="Book.author" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Book.description" class="form-label">Description</label>
            <input asp-for="Book.description" class="form-control" />
            <span asp-validation-for="Book.description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Book.publisher" class="form-label">Publisher</label>
            <input asp-for="Book.publisher" class="form-control" />
            <span asp-validation-for="Book.publisher" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Book.status" class="form-label">Status</label>
            <input asp-for="Book.status" class="form-control" />
            <span asp-validation-for="Book.status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Book.category" class="form-label">Category</label>
            <input asp-for="Book.category" class="form-control" />
            <span asp-validation-for="Book.category" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Save Book</button>
        <a asp-page="/Books/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
