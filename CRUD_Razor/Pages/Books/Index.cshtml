@page
@model CRUD_Razor.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Books";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Books Management</h2>
            <p class="text-muted">View and manage your library books.</p>
        </div>

        <a asp-page="/Books/Create" class="btn btn-success">
            + Add New Book
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Description</th>
                    <th>Publisher</th>
                    <th>Status</th>
                    <th>Category</th>
                    <th style="min-width: 150px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Books.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            No books found. Click Add New Book to get started.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>@book.Id</td>
                            <td>@book.title</td>
                            <td>@book.author</td>
                            <td>@book.description</td>
                            <td>@book.publisher</td>
                            <td>@book.status</td>
                            <td>@book.category</td>
                            <td>
                                <a asp-page="/Books/Edit"
                                   asp-route-id="@book.Id"
                                   class="btn btn-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-page="/Books/Delete"
                                   asp-route-id="@book.Id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <a asp-page="/Index" class="btn btn-outline-secondary">
        Home
    </a>
</div>
