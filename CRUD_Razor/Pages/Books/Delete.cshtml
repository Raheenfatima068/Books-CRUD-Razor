@page "{id:int}"
@model CRUD_Razor.Pages.Books.DeleteModel

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">
    <h2>Delete Book</h2>

    <div class="alert alert-warning mt-3">
        <strong>Warning!</strong>
        Are you sure you want to delete this book?
        This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Book.Id</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Book.title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">@Model.Book.author</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Book.description</dd>

        <dt class="col-sm-3">Publisher</dt>
        <dd class="col-sm-9">@Model.Book.publisher</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Book.status</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Book.category</dd>
    </dl>

    <form method="post" asp-route-id="@Model.Book.Id">
        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-page="/Books/Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
